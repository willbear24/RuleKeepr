# Copy this file to .env and fill in the values. Never commit .env.

# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model pulled by the ollama-pull service and used by the backend
LLM_MODEL=llama3.2
